{
  "steps": [
    {
      "type": "sound", "path": "assets/sfx/spray.ogg", "volume": 0.9,
      "if": "ruins.r2.battle_rescue_seen == 0"
    },
    { "type": "waterBurst", "npc": "floofy", "if": "ruins.r2.battle_rescue_seen == 0" },
    {
      "type": "shake", "intensity": 3.0, "seconds": 0.3,
      "if": "ruins.r2.battle_rescue_seen == 0"
    },
    {
      "type": "npcAnim", "npc": "floofy", "key": "soaked",
      "if": "ruins.r2.battle_rescue_seen == 0"
    },
    { "type": "wait", "seconds": 0.6, "if": "ruins.r2.battle_rescue_seen == 0" },
    {
      "type": "dialog", "speaker": "FLOOFY", "lines": ["EEP!!"],
      "if": "ruins.r2.battle_rescue_seen == 0"
    },
    { "type": "wait", "seconds": 0.35, "if": "ruins.r2.battle_rescue_seen == 0" },
    {
      "type": "dialog", "speaker": "FLOOFY",
      "lines": ["My BLOWOUT!", "This isn't over, gamer! I know where you SAVE~!"],
      "if": "ruins.r2.battle_rescue_seen == 0"
    },
    { "type": "sound", "path": "assets/sfx/pounce.ogg", "volume": 0.8 },
    { "type": "moveNpc", "npc": "floofy", "x": 170, "y": 115, "speed": 240 },
    { "type": "npcAnim", "npc": "floofy", "key": "dive", "seconds": 0.45 },
    { "type": "hideNpc", "npc": "floofy" },
    { "type": "wait", "seconds": 0.45 },
    { "type": "setFlag", "key": "ruins.furiell.r2_arrived", "value": 1 },
    { "type": "facePlayer", "key": "down" },
    { "type": "movePlayer", "x": 318, "y": 400, "speed": 140 },
    { "type": "npcFace", "npc": "furiell", "key": "up" },
    { "type": "moveNpc", "npc": "furiell", "x": 278, "y": 400, "speed": 120 },
    {
      "type": "dialog", "speaker": "FURIELL", "portrait": "furiell_angry",
      "lines": ["Bad flower! BAD! *spritz* *spritz* Shoo!"]
    },
    {
      "type": "dialog", "speaker": "FURIELL", "portrait": "furiell_sad",
      "lines": ["Oh, you poor pup... did that nasty weed get you all fluffy? >w<"]
    },
    { "type": "npcAnim", "npc": "furiell", "key": "spritz_right" },
    { "type": "sound", "path": "assets/sfx/glitter_spray.ogg", "volume": 0.8 },
    { "type": "waterBurst", "npc": "player" },
    { "type": "dialog", "speaker": "NARRATOR", "lines": ["* Furiell spritzes you."] },
    { "type": "healFull" },
    { "type": "setFur", "value": 0 },
    { "type": "setFlag", "key": "fur_mirror_pending", "value": 0 },
    {
      "type": "dialog", "speaker": "FURIELL", "portrait": "furiell_happy",
      "lines": ["It's just water and a little lavender, hun. It washes the fluff right off~"]
    },
    { "type": "wait", "seconds": 0.4 },
    { "type": "npcAnim", "npc": "furiell", "key": "talk_down" },
    {
      "type": "dialog", "speaker": "FURIELL", "portrait": "furiell_neutral",
      "lines": [
        "*grabs your hand* Hewwo~! I'm Furiell! I take care of the Ruins.",
        "You must be new. You smell new. uwu",
        "...You're not even green. The murals lied~"
      ]
    },
    {
      "type": "dialog", "speaker": "FURIELL", "portrait": "furiell_happy",
      "lines": ["Come, come! I'll show you around.", "...I'm not letting go, by the way."]
    },
    { "type": "npcFace", "npc": "furiell", "key": "up" },
    { "type": "facePlayer", "key": "up" },
    { "type": "moveNpc", "npc": "furiell", "x": 330, "y": 350, "speed": 90 },
    { "type": "movePlayer", "x": 330, "y": 400, "speed": 90 },
    { "type": "moveNpc", "npc": "furiell", "x": 398, "y": 300, "speed": 90 },
    { "type": "movePlayer", "x": 398, "y": 350, "speed": 90 },
    { "type": "moveNpc", "npc": "furiell", "x": 398, "y": 200, "speed": 90 },
    { "type": "movePlayer", "x": 398, "y": 250, "speed": 90 },
    { "type": "moveNpc", "npc": "furiell", "x": 398, "y": 120, "speed": 90 },
    { "type": "movePlayer", "x": 398, "y": 170, "speed": 90 },
    { "type": "moveNpc", "npc": "furiell", "x": 330, "y": 50, "speed": 90 },
    { "type": "movePlayer", "x": 318, "y": 30, "speed": 90 },
    { "type": "setFlag", "key": "ruins.floofy.met", "value": 1 }
  ]
}
